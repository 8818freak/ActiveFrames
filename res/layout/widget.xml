<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Feste (korrekte) Variante: Zeilen zur Laufzeit hier eingehängt (kein
         Adapter -> kein Recycling, keine vertauschten Kacheln, variable Höhen). -->
    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Scrollbare Variante (Sammlung): mehr Kacheln als sichtbar, aber auf
         alten Launchern fehlerhaftes Recycling. Nur sichtbar, wenn Scrollen an. -->
    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:numColumns="2"
        android:horizontalSpacing="14dp"
        android:verticalSpacing="14dp"
        android:stretchMode="columnWidth"
        android:scrollbars="none"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#99AAB8"
        android:textSize="13sp"
        android:padding="12dp"
        android:text="@string/empty_hint"
        android:visibility="gone" />
</FrameLayout>
