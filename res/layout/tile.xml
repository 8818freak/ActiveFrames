<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Die eigentliche Kachel-Karte, oben/rechts etwas eingerueckt, damit der
         Stern in der freien Ecke sitzt und die Karte nur zu ~einem Viertel
         ueberlappt (der Rasterabstand liefert den Platz dafuer). -->
    <FrameLayout
        android:id="@+id/tile_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/tile_bg"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/tile_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tile_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:visibility="gone" />

        <!-- Untere Leiste: [Symbol]  Name  ............  [X] -->
        <LinearLayout
            android:id="@+id/tile_bar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bar_bg"
            android:paddingStart="8dp"
            android:paddingEnd="0dp">

            <ImageView
                android:id="@+id/tile_icon"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:id="@+id/tile_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <!-- Grosszuegiges Tippziel (verfehlte man den kleinen Knopf, startete
                 stattdessen die App). Fuellt die volle Balkenhoehe. -->
            <ImageView
                android:id="@+id/tile_close"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </FrameLayout>

    <!-- Roter BB-Stern in der oberen rechten Ecke, ueberlappt die Karte zu ~1/4 -->
    <ImageView
        android:id="@+id/tile_star"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_star_badge"
        android:visibility="gone" />
</FrameLayout>
